# ----------------------------------------------------------------------------
# Supabase — Project Settings > API en tu dashboard
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Omite RLS. Solo servidor, NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# URL pública del sitio. En local dejala así; en Vercel poné tu dominio.
# La usan el OAuth de Google y los success_url de Stripe.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Stripe — opcional.
# Sin estas claves el checkout funciona en modo simulado: registra el pedido
# y muestra la confirmación, pero no cobra.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
